---
// src/components/arteterapia/FooterUniversale.astro
const base = import.meta.env.BASE_URL;
const link = (path: string) => base === '/' ? path : `${base.replace(/\/$/, '')}${path.startsWith('/') ? '' : '/'}${path}`;
---

<footer class="bg-stone-800 text-stone-300 py-12 mt-auto">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-8">
    
    <!-- Colonna 1: Identità + Social Arteterapia -->
    <div>
      <h4 class="text-xl font-serif text-white mb-4">Cristiana Scoppetta</h4>
      <p class="text-sm leading-relaxed mb-6">
        Sociologa, artista e arteterapeuta in formazione.<br/>
        Uno spazio di ascolto, espressione e benessere attraverso il processo creativo.
      </p>

      <!-- Icone Social Arteterapia -->
      <div class="flex items-center gap-3">
        <a 
          href="https://www.facebook.com/share/1bnVAcnZbx/" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Seguimi su Facebook - Arteterapia"
          class="p-2.5 rounded-full bg-white/10 hover:bg-teal-600 text-white transition-all duration-300 hover:scale-110"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
          </svg>
        </a>

        <a 
          href="https://www.instagram.com/dr.cris.scoppetta.arteterapia" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Seguimi su Instagram - Arteterapia"
          class="p-2.5 rounded-full bg-white/10 hover:bg-teal-600 text-white transition-all duration-300 hover:scale-110"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Colonna 2: Navigazione trasversale (Senza Sociologa) -->
    <div>
      <h4 class="text-lg text-white mb-4 font-serif">I miei mondi</h4>
      <ul class="space-y-2 text-sm">
        <li><a href={link('/arteterapia')} class="hover:text-white transition-colors">Arteterapia (Il percorso)</a></li>
        <li><a href={link('/artista')} class="hover:text-white transition-colors">Artista (Il portfolio)</a></li>
        <li><a href={link('/blog')} class="hover:text-white transition-colors">Blog (Articoli e riflessioni)</a></li>
        <li><a href="https://www.arteliberatuttiitalia.it/alti" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Associazione Arte Libera Tutti</a></li>
      </ul>
    </div>

    <!-- Colonna 3: Riferimenti -->
    <div>
      <h4 class="text-lg text-white mb-4 font-serif">Riferimenti</h4>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="https://evolutionaccademia.it/" target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors">
            Sito Ufficiale Evolution Accademia
          </a>
        </li>
      </ul>
    </div>

  </div>
  
  <div class="max-w-6xl mx-auto px-6 mt-12 pt-6 border-t border-stone-700 text-sm text-center text-stone-500">
    &copy; {new Date().getFullYear()} Cristiana Scoppetta. Tutti i diritti riservati.
  </div>
</footer>