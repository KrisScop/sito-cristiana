---
// Qui definiamo le variabili che il componente si aspetta di ricevere
interface Props {
  title: string;
  description: string;
}

// Estraiamo le variabili passate al componente
const { title, description } = Astro.props;
---

<div class="bg-white p-8 rounded-xl shadow-sm border border-stone-200 text-center hover:shadow-md transition-shadow">
  <h3 class="text-2xl font-serif text-stone-800 mb-3">{title}</h3>
  <p class="text-stone-600">{description}</p>
</div>