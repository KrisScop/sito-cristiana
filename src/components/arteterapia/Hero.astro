---
// src/components/arteterapia/Hero.astro
const base = import.meta.env.BASE_URL;
const link = (path: string) => base === '/' ? path : `${base.replace(/\/$/, '')}${path.startsWith('/') ? '' : '/'}${path}`;
---

<section class="bg-stone-200 py-20 px-6 text-center">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-serif text-stone-800 mb-6">
      Esplora le tue emozioni attraverso l'espressione creativa.
    </h1>
    <p class="text-lg md:text-xl text-stone-600 mb-8 leading-relaxed">
      Un percorso di arteterapia per ritrovare equilibrio e ascolto interiore, senza bisogno di saper disegnare. Il processo creativo è il vero spazio di benessere.
    </p>
    <a href={link('/arteterapia/percorsi')} class="inline-block bg-teal-700 text-white px-8 py-3.5 rounded-full font-medium hover:bg-teal-800 transition-colors shadow-xs">
      Scopri i percorsi
    </a>
  </div>
</section>