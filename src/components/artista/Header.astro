---
// src/components/artista/Header.astro (Versione Artista - Minimal White Cube)
const base = import.meta.env.BASE_URL;
const link = (path: string) => base === '/' ? path : `${base.replace(/\/$/, '')}${path.startsWith('/') ? '' : '/'}${path}`;
---

<header class="bg-white sticky top-0 z-50 border-b border-zinc-100">
  <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row justify-between items-center gap-4">
    
    <!-- Logo Minimal -->
    <a href={link('/artista')} class="text-xl font-sans text-zinc-900 tracking-wide uppercase hover:text-zinc-500 transition-colors text-center">
      Cristiana Scoppetta
    </a>

    <!-- Navigazione -->
    <nav class="flex flex-wrap justify-center gap-6 md:gap-8 text-xs md:text-sm uppercase tracking-wider font-medium">
      <a href={link('/artista/portfolio')} class="text-zinc-500 hover:text-zinc-900 transition-colors">Portfolio</a>
      <a href={link('/artista/about')} class="text-zinc-500 hover:text-zinc-900 transition-colors">About</a>
      <a href={link('/blog')} class="text-zinc-500 hover:text-zinc-900 transition-colors">Blog</a>
      <a href={link('/artista/contact')} class="text-zinc-500 hover:text-zinc-900 transition-colors">Contact</a>
    </nav>
    
  </div>
</header>