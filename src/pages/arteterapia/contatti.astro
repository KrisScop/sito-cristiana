---
// src/pages/arteterapia/contatti.astro
export const prerender = true;

import Layout from '../../layouts/arteterapia/Layout.astro';
---

<Layout 
  title="Contatti e Colloqui | Cristiana Scoppetta - Arteterapia"
  description="Contatta Cristiana Scoppetta a Trieste e online per informazioni sui percorsi individuali e di gruppo di arteterapia."
>
  <section class="bg-stone-100 py-16 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-serif text-stone-800 mb-4">
        Iniziamo un dialogo
      </h1>
      <p class="text-lg text-stone-600 leading-relaxed">
        Scrivimi per richiedere informazioni sui percorsi individuali o di gruppo, oppure per fissare un primo colloquio conoscitivo.
      </p>
    </div>
  </section>

  <section class="py-16 px-6 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-start">
      
      <!-- COLONNA SINISTRA: RECAPITI E INFORMAZIONI -->
      <div>
        <h2 class="text-2xl font-serif text-stone-800 mb-4">Dove e come ricevo</h2>
        <p class="text-stone-600 leading-relaxed mb-8">
          Gli incontri di arteterapia si svolgono in presenza a <strong>Trieste</strong> oppure in modalità <strong>online</strong>, concordando insieme giorni e orari in base alle tue esigenze.
        </p>

        <h3 class="text-xl font-serif text-stone-800 mb-5">I Miei Recapiti</h3>
        <div class="space-y-4 text-stone-700">
          <div class="flex items-start gap-4">
            <span class="text-2xl">📍</span>
            <div>
              <strong>Studio / Sede Operativa:</strong><br/>
              Via Tivarnella, 3<br/>
              34132 Trieste (TS)
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-2xl">✉️</span>
            <a href="mailto:info@cristianascoppetta.it" class="hover:text-teal-700 transition-colors underline underline-offset-4">
              info@cristianascoppetta.it
            </a>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-2xl">📞</span>
            <a href="tel:+393929536189" class="hover:text-teal-700 transition-colors">
              (+39) 392.953.6189 (anche WhatsApp)
            </a>
          </div>
        </div>

        <!-- Box Social Arteterapia -->
        <div class="mt-10 bg-stone-100 p-6 rounded-2xl border border-stone-200">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700 block mb-2">Canali Social Dedicati</span>
          <p class="text-sm text-stone-600 mb-4">
            Seguimi o scrivimi un messaggio diretto sulle pagine dedicate all'Arteterapia:
          </p>
          <div class="flex flex-wrap gap-3">
            <a 
              href="https://www.instagram.com/dr.cris.scoppetta.arteterapia" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-4 py-2 rounded-full bg-white border border-stone-300 text-stone-700 hover:border-teal-600 hover:text-teal-700 transition-colors text-xs font-medium"
            >
              Instagram Arteterapia &rarr;
            </a>
            <a 
              href="https://www.facebook.com/share/1bnVAcnZbx/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-4 py-2 rounded-full bg-white border border-stone-300 text-stone-700 hover:border-teal-600 hover:text-teal-700 transition-colors text-xs font-medium"
            >
              Facebook Arteterapia &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- COLONNA DESTRA: MODULO DI CONTATTO CON WEB3FORMS -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-md border border-stone-200">
        
        <h2 class="text-2xl font-serif text-stone-800 mb-6" id="form-title">Scrivimi un messaggio</h2>
        
        <!-- MESSAGGIO DI SUCCESSO (Nascosto di default) -->
        <div id="form-success" class="hidden text-center py-8">
          <div class="text-5xl mb-4">✨</div>
          <h3 class="text-2xl font-serif text-teal-700 mb-2">Messaggio inviato!</h3>
          <p class="text-stone-600">Grazie per avermi contattato. Ti risponderò il prima possibile.</p>
        </div>

        <!-- MESSAGGIO DI ERRORE / QUOTA SUPERATA ("Piano B") -->
        <div id="form-error" class="hidden text-center py-8 bg-red-50 rounded-2xl border border-red-100">
          <div class="text-4xl mb-4">⚠️</div>
          <h3 class="text-xl font-bold text-red-800 mb-2">Servizio temporaneamente inattivo</h3>
          <p class="text-red-600 mb-4 px-4 text-sm">
            Il modulo di invio rapido è temporaneamente in pausa. Puoi scrivermi direttamente cliccando qui sotto:
          </p>
          <a href="mailto:info@cristianascoppetta.it" class="inline-block bg-white text-red-700 border border-red-200 px-6 py-2.5 rounded-full font-medium hover:bg-red-50 transition">
            Scrivimi via Email (info@cristianascoppetta.it)
          </a>
        </div>
        
        <!-- IL MODULO WEB3FORMS -->
        <form id="contact-form" class="space-y-5">
          
          <!-- CHIAVE WEB3FORMS ATTIVA -->
          <input type="hidden" name="access_key" value="169c3fe2-c08c-4f60-9318-e1ed3a233a07">
          
          <!-- Intestazione email -->
          <input type="hidden" name="subject" value="Nuova richiesta dal sito - Sezione Arteterapia">
          <input type="hidden" name="from_name" value="Sito Cristiana Scoppetta (Arteterapia)">
          
          <!-- Anti-spam honeypot -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nome" class="block text-sm font-medium text-stone-700 mb-1.5">Nome</label>
              <input type="text" id="nome" name="Nome" required class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-600/40 focus:border-teal-600 bg-stone-50 focus:bg-white">
            </div>
            <div>
              <label for="cognome" class="block text-sm font-medium text-stone-700 mb-1.5">Cognome</label>
              <input type="text" id="cognome" name="Cognome" required class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-600/40 focus:border-teal-600 bg-stone-50 focus:bg-white">
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-stone-700 mb-1.5">Email</label>
            <input type="email" id="email" name="Email_Utente" required class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-600/40 focus:border-teal-600 bg-stone-50 focus:bg-white">
          </div>

          <div>
            <label for="messaggio" class="block text-sm font-medium text-stone-700 mb-1.5">Messaggio</label>
            <textarea id="messaggio" name="Messaggio" rows="4" required class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-600/40 focus:border-teal-600 bg-stone-50 focus:bg-white resize-none"></textarea>
          </div>

          <button type="submit" id="submit-btn" class="w-full bg-teal-700 text-white font-medium px-6 py-4 rounded-xl hover:bg-teal-800 transition shadow-md flex justify-center items-center gap-2 cursor-pointer">
            <span>Invia Messaggio</span>
          </button>
          
        </form>
      </div>

    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const resultSuccess = document.getElementById('form-success');
    const resultError = document.getElementById('form-error');
    const formTitle = document.getElementById('form-title');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btnSpan = submitBtn?.querySelector('span');
        if (btnSpan) btnSpan.textContent = 'Invio in corso...';
        if (submitBtn) submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        
        const formData = new FormData(form);
        const object = Object.fromEntries(formData);
        const json = JSON.stringify(object);

        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        })
        .then(async (response) => {
          let jsonResponse = await response.json();
          
          if (response.status == 200) {
            form.classList.add('hidden');
            if (formTitle) formTitle.classList.add('hidden');
            if (resultSuccess) resultSuccess.classList.remove('hidden');
          } else {
            console.log(jsonResponse);
            form.classList.add('hidden');
            if (formTitle) formTitle.classList.add('hidden');
            if (resultError) resultError.classList.remove('hidden');
          }
        })
        .catch(error => {
          console.log(error);
          form.classList.add('hidden');
          if (formTitle) formTitle.classList.add('hidden');
          if (resultError) resultError.classList.remove('hidden');
        });
      });
    }
  });
</script>