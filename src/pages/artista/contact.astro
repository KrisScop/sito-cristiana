---
// src/pages/artista/contact.astro
export const prerender = true;

import Layout from '../../layouts/artista/Layout.astro';
---

<Layout
  title="Contact & Studio | Cristiana Scoppetta - Artista"
  description="Contatta l'artista Cristiana Scoppetta per informazioni sulle opere, disponibilità per mostre, cataloghi o collaborazioni con gallerie."
>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-sans tracking-wide uppercase text-zinc-900 mb-4">Contact</h1>
    <p class="text-zinc-600 mb-12 max-w-2xl leading-relaxed">
      Per richieste di informazioni relative alle opere, disponibilità per esposizioni, visite in studio o collaborazioni con gallerie e curatori, puoi compilare il modulo o utilizzare i recapiti diretti.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      
      <!-- COLONNA SINISTRA: INFO STUDIO E SOCIAL ARTISTA (5 colonne) -->
      <div class="md:col-span-5 bg-zinc-50 p-8 border border-zinc-200 text-sm space-y-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-zinc-400 block mb-1">Studio / Atelier</span>
          <p class="text-zinc-900 font-medium">Via Tivarnella, 3 — 34132 Trieste (Italia)</p>
        </div>

        <div>
          <span class="text-xs uppercase tracking-widest text-zinc-400 block mb-1">Email Diretta</span>
          <a href="mailto:info@cristianascoppetta.it" class="text-zinc-900 underline underline-offset-4 hover:text-zinc-600 transition-colors">
            info@cristianascoppetta.it
          </a>
        </div>

        <div>
          <span class="text-xs uppercase tracking-widest text-zinc-400 block mb-1">Telefono / WhatsApp</span>
          <a href="tel:+393929536189" class="text-zinc-900 hover:text-zinc-600 transition-colors">
            (+39) 392.953.6189
          </a>
        </div>

        <div class="pt-4 border-t border-zinc-200">
          <span class="text-xs uppercase tracking-widest text-zinc-400 block mb-3">Profili Ufficiali Artista</span>
          <div class="flex flex-col space-y-2">
            <a 
              href="https://www.instagram.com/cristiana_scoppetta_artista" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-zinc-900 hover:text-zinc-500 underline underline-offset-4 transition-colors"
            >
              Instagram: @cristiana_scoppetta_artista &rarr;
            </a>
            <a 
              href="https://www.facebook.com/share/1bfE2VtZwf/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-zinc-900 hover:text-zinc-500 underline underline-offset-4 transition-colors"
            >
              Facebook: Cristiana Scoppetta Artista &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- COLONNA DESTRA: MODULO WEB3FORMS STILE WHITE CUBE (7 colonne) -->
      <div class="md:col-span-7 border border-zinc-200 p-8 sm:p-10 bg-white">
        <h2 class="text-lg font-sans uppercase tracking-wider text-zinc-900 mb-6" id="form-title">Invia una richiesta</h2>

        <!-- MESSAGGIO DI SUCCESSO -->
        <div id="form-success" class="hidden text-center py-8">
          <h3 class="text-xl font-serif text-zinc-900 mb-2">Messaggio inviato</h3>
          <p class="text-zinc-600 text-sm">Grazie per il tuo interesse. Risponderò alla tua richiesta il prima possibile.</p>
        </div>

        <!-- MESSAGGIO DI ERRORE ("Piano B") -->
        <div id="form-error" class="hidden text-center py-8 bg-zinc-50 border border-zinc-300">
          <h3 class="text-base font-bold uppercase tracking-wider text-zinc-900 mb-2">Servizio temporaneamente non disponibile</h3>
          <p class="text-zinc-600 mb-4 px-4 text-xs">
            È possibile inviare direttamente una comunicazione via email cliccando qui sotto:
          </p>
          <a href="mailto:info@cristianascoppetta.it" class="inline-block bg-zinc-900 text-white px-6 py-2.5 text-xs uppercase tracking-widest hover:bg-zinc-700 transition">
            Scrivi a info@cristianascoppetta.it
          </a>
        </div>

        <form id="contact-form-artista" class="space-y-5">
          <!-- CHIAVE WEB3FORMS DI CRISTIANA -->
          <input type="hidden" name="access_key" value="169c3fe2-c08c-4f60-9318-e1ed3a233a07">
          <input type="hidden" name="subject" value="Nuova richiesta dal Portfolio Artista (cristianascoppetta.it)">
          <input type="hidden" name="from_name" value="Portfolio Artista - Cristiana Scoppetta">
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nome" class="block text-xs uppercase tracking-wider text-zinc-600 mb-2">Nome</label>
              <input type="text" id="nome" name="Nome" required class="w-full px-4 py-3 border border-zinc-300 focus:outline-none focus:border-zinc-900 bg-zinc-50 focus:bg-white text-sm">
            </div>
            <div>
              <label for="cognome" class="block text-xs uppercase tracking-wider text-zinc-600 mb-2">Cognome</label>
              <input type="text" id="cognome" name="Cognome" required class="w-full px-4 py-3 border border-zinc-300 focus:outline-none focus:border-zinc-900 bg-zinc-50 focus:bg-white text-sm">
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs uppercase tracking-wider text-zinc-600 mb-2">Email</label>
            <input type="email" id="email" name="Email_Utente" required class="w-full px-4 py-3 border border-zinc-300 focus:outline-none focus:border-zinc-900 bg-zinc-50 focus:bg-white text-sm">
          </div>

          <div>
            <label for="messaggio" class="block text-xs uppercase tracking-wider text-zinc-600 mb-2">Messaggio / Opera di interesse</label>
            <textarea id="messaggio" name="Messaggio" rows="4" required class="w-full px-4 py-3 border border-zinc-300 focus:outline-none focus:border-zinc-900 bg-zinc-50 focus:bg-white text-sm resize-none"></textarea>
          </div>

          <button type="submit" id="submit-btn" class="w-full bg-zinc-900 text-white text-xs uppercase tracking-widest px-6 py-4 hover:bg-zinc-700 transition cursor-pointer">
            <span>Invia Messaggio</span>
          </button>
        </form>
      </div>

    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form-artista') as HTMLFormElement | null;
    const resultSuccess = document.getElementById('form-success');
    const resultError = document.getElementById('form-error');
    const formTitle = document.getElementById('form-title');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btnSpan = submitBtn?.querySelector('span');
        if (btnSpan) btnSpan.textContent = 'Invio in corso...';
        if (submitBtn) submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        
        const formData = new FormData(form);
        const object = Object.fromEntries(formData);
        const json = JSON.stringify(object);

        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        })
        .then(async (response) => {
          if (response.status == 200) {
            form.classList.add('hidden');
            if (formTitle) formTitle.classList.add('hidden');
            if (resultSuccess) resultSuccess.classList.remove('hidden');
          } else {
            form.classList.add('hidden');
            if (formTitle) formTitle.classList.add('hidden');
            if (resultError) resultError.classList.remove('hidden');
          }
        })
        .catch(() => {
          form.classList.add('hidden');
          if (formTitle) formTitle.classList.add('hidden');
          if (resultError) resultError.classList.remove('hidden');
        });
      });
    }
  });
</script>