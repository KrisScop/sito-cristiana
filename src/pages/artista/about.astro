---
// src/pages/artista/about.astro
export const prerender = true;

import Layout from '../../layouts/artista/Layout.astro';

const base = import.meta.env.BASE_URL;
const link = (path: string) => base === '/' ? path : `${base.replace(/\/$/, '')}${path.startsWith('/') ? '' : '/'}${path}`;
---

<Layout
  title="About & Statement | Cristiana Scoppetta - Artista"
  description="Biografia, Artist Statement ed esposizioni di Cristiana Scoppetta, artista contemporanea."
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-sans tracking-wide uppercase text-zinc-900 mb-8">About</h1>
    
    <!-- Artist Statement -->
    <div class="mb-16">
      <h2 class="text-xl font-medium text-zinc-900 mb-4 tracking-wide font-sans">Artist Statement</h2>
      <p class="text-zinc-600 leading-relaxed text-base">
        La mia ricerca artistica indaga il rapporto tra memoria, materia e spazio interiore. Attraverso l'uso della pittura materica e del colore, decostruisco elementi del quotidiano per rivelare strati nascosti di significato e geografie emotive.
      </p>
    </div>

    <!-- Curriculum / CV Espositivo -->
    <div class="space-y-10 text-sm">
      <div>
        <h3 class="text-zinc-900 font-medium uppercase tracking-wider mb-4 border-b border-zinc-200 pb-2 font-sans">Mostre Personali</h3>
        <ul class="space-y-3 text-zinc-600">
          <li><strong class="text-zinc-900">2025</strong> – "Titolo Mostra", Galleria / Spazio, Città</li>
          <li><strong class="text-zinc-900">2023</strong> – "Titolo Mostra", Galleria / Spazio, Città</li>
        </ul>
      </div>

      <div>
        <h3 class="text-zinc-900 font-medium uppercase tracking-wider mb-4 border-b border-zinc-200 pb-2 font-sans">Mostre Collettive</h3>
        <ul class="space-y-3 text-zinc-600">
          <li><strong class="text-zinc-900">2024</strong> – "Titolo Collettiva", Spazio Espositivo, Città</li>
          <li><strong class="text-zinc-900">2022</strong> – "Titolo Collettiva", Museo / Fondazione, Città</li>
        </ul>
      </div>

      <div>
        <h3 class="text-zinc-900 font-medium uppercase tracking-wider mb-4 border-b border-zinc-200 pb-2 font-sans">Premi e Residenze</h3>
        <ul class="space-y-3 text-zinc-600">
          <li><strong class="text-zinc-900">2023</strong> – Residenza Artistica Internazionale, Nome Residenza</li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-zinc-100 flex flex-wrap gap-6 text-xs uppercase tracking-widest">
      <a href={link('/artista/portfolio')} class="bg-zinc-900 text-white px-6 py-3 hover:bg-zinc-700 transition-colors">
        Esplora il Portfolio &rarr;
      </a>
      <a href={link('/blog')} class="border border-zinc-300 text-zinc-700 px-6 py-3 hover:border-zinc-900 hover:text-zinc-900 transition-colors">
        Diario d'Atelier (Blog)
      </a>
    </div>
  </section>
</Layout>