---
// src/layouts/artista/Layout.astro
import "../../styles/artista/global.css";
import Header from '../../components/artista/Header.astro';
import FooterUniversale from '../../components/artista/FooterUniversale.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Cristiana Scoppetta | Contemporary Artist & Portfolio", 
  description = "Portfolio ufficiale di Cristiana Scoppetta, artista contemporanea. Esplora le opere, i cicli pittorici, la ricerca materica e le esposizioni." 
} = Astro.props;

const base = import.meta.env.BASE_URL;
const faviconUrl = base === '/' ? '/favicon.svg' : `${base}/favicon.svg`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="it" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Meta tag fondamentali per la SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Meta tag Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cristiana Scoppetta - Artista" />
    <meta property="og:locale" content="it_IT" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
</head>
<!-- Tema "White Cube": Sfondo bianco puro, testo zinc (neutro/freddo) -->
<body class="bg-white text-zinc-900 font-sans antialiased min-h-screen flex flex-col">
    
    <Header />

    <main class="grow">
        <slot />
    </main>
    
    <FooterUniversale />
</body>
</html>